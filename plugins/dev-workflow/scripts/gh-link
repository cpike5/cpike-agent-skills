#!/bin/bash
# Link a child issue to a parent issue as a sub-issue
# Usage: gh-link -Parent NUMBER -Child NUMBER

set -e

PARENT=""
CHILD=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -Parent|--parent|-p)
            PARENT="$2"
            shift 2
            ;;
        -Child|--child|-c)
            CHILD="$2"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

if [ -z "$PARENT" ] || [ -z "$CHILD" ]; then
    echo "Usage: gh-link -Parent NUMBER -Child NUMBER"
    exit 1
fi

# Get issue IDs
PARENT_ID=$(gh issue view "$PARENT" --json id --jq '.id')
CHILD_ID=$(gh issue view "$CHILD" --json id --jq '.id')

if [ -z "$PARENT_ID" ]; then
    echo "Error: Failed to get parent issue #$PARENT"
    exit 1
fi

if [ -z "$CHILD_ID" ]; then
    echo "Error: Failed to get child issue #$CHILD"
    exit 1
fi

# Create the sub-issue relationship
QUERY='mutation { addSubIssue(input: {issueId: "'"$PARENT_ID"'", subIssueId: "'"$CHILD_ID"'"}) { issue { title number } subIssue { title number } } }'

gh api graphql -H "GraphQL-Features: sub_issues" -f query="$QUERY" > /dev/null

echo "Successfully linked issue #$CHILD as sub-issue of #$PARENT"
