#!/bin/bash
# List Elasticsearch indices with optional grep filter.
# Usage: es-indices [filter]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FILTER="${1:-}"

OUTPUT=$("$SCRIPT_DIR/es-api" GET /_cat/indices?v)

if [[ -n "$FILTER" ]]; then
  # Keep header line, then grep the rest
  echo "$OUTPUT" | head -1
  echo "$OUTPUT" | tail -n +2 | grep -i -- "$FILTER" || true
else
  echo "$OUTPUT"
fi
