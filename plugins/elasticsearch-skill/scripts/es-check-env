#!/bin/bash
# Validates that the .env file exists and required variables are set.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(dirname "$SCRIPT_DIR")"
ENV_FILE="$PLUGIN_ROOT/.env"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "Error: .env file not found at $ENV_FILE" >&2
  echo "Copy .env.example to .env and fill in your credentials:" >&2
  echo "  cp $PLUGIN_ROOT/.env.example $ENV_FILE" >&2
  exit 1
fi

source "$ENV_FILE"

errors=0

if [[ -z "${ES_URL:-}" ]]; then
  echo "Error: ES_URL is not set in $ENV_FILE" >&2
  errors=$((errors + 1))
fi

if [[ -z "${ES_API_KEY:-}" ]]; then
  echo "Error: ES_API_KEY is not set in $ENV_FILE" >&2
  errors=$((errors + 1))
fi

if [[ $errors -gt 0 ]]; then
  exit 1
fi

echo "Environment OK"
