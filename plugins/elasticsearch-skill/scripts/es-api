#!/bin/bash
# Elasticsearch REST API wrapper.
# Usage: es-api [METHOD] /path [body]
# If METHOD is omitted, infers GET (no body) or POST (with body).
# Body can be a JSON string or "-" for stdin.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(dirname "$SCRIPT_DIR")"

# Validate environment
source "$SCRIPT_DIR/es-check-env" > /dev/null

# Parse arguments: detect whether first arg is a method or a path
ARG1="${1:?Usage: es-api [METHOD] /path [body]}"
shift

case "$ARG1" in
  GET|POST|PUT|DELETE|PATCH|HEAD)
    METHOD="$ARG1"
    PATH_ARG="${1:?Usage: es-api METHOD /path [body]}"
    shift
    BODY="${1:-}"
    ;;
  /*)
    PATH_ARG="$ARG1"
    BODY="${1:-}"
    if [[ -n "$BODY" ]]; then
      METHOD="POST"
    else
      METHOD="GET"
    fi
    ;;
  *)
    echo "Error: first argument must be an HTTP method or a path starting with /" >&2
    exit 1
    ;;
esac

CURL_ARGS=(
  -s
  -X "$METHOD"
  -H "Authorization: ApiKey $ES_API_KEY"
  -H "Content-Type: application/json"
  "${ES_URL}${PATH_ARG}"
)

if [[ -n "$BODY" ]]; then
  if [[ "$BODY" == "-" ]]; then
    CURL_ARGS+=(-d @-)
  else
    CURL_ARGS+=(-d "$BODY")
  fi
fi

OUTPUT=$(curl "${CURL_ARGS[@]}")

if command -v jq &> /dev/null && [[ -t 1 ]]; then
  echo "$OUTPUT" | jq .
else
  echo "$OUTPUT"
fi
