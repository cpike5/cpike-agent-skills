# /opt/<appname>/.env  — copy from this file and fill in.
#
# This is the only place secrets live on the VPS. Lock it down:
#   sudo chown root:root /opt/<appname>/.env && sudo chmod 600 /opt/<appname>/.env
#
# docker compose reads it automatically from the compose file's directory.
# Never commit the filled-in version; commit only this .example.

# Image tag to run. "latest" tracks the newest published release; pin to a
# version (e.g. 1.4.0) to hold a box back or to roll back after a bad deploy.
APP_TAG=latest

ASPNETCORE_ENVIRONMENT=Production

# Host port nginx proxies to. Must match proxy_pass in the nginx site config.
APP_PORT=5000

# Postgres. Generate the password once: openssl rand -base64 32
POSTGRES_DB=<appname>
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Absolute host path for uploads, if you'd rather not use the named volume.
#UPLOADS_VOLUME=/opt/<appname>/uploads
